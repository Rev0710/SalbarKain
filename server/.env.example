NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173
# Set TRUST_PROXY=1 on Render so IP-based limits use the client address.
TRUST_PROXY=0
# Copy this to server/.env and paste your Atlas M0 URI.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/salbar_kain?retryWrites=true&w=majority
# Use a cryptographically random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret
# Optional separate HMAC key for pseudonymized authentication and security audit identifiers.
AUTH_LOG_HMAC_SECRET=replace-with-a-different-random-secret
# Local development-only password used by npm --workspace server run seed.
SEED_PASSWORD=
# Cloudinary free account credentials (server-side only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Gmail SMTP app credentials for password-change verification emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender override; defaults to SMTP_USER.
SMTP_FROM=
